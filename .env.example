# Copy this file to .env in the project root and fill in real values, or set
# these as real process/web-server environment variables instead -- either
# works. A value in .env always wins over one already set in the environment
# (see loadEnvFile() in app/config.php), so never deploy a .env file to
# production; .env is already .gitignore'd for that reason.
DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_CHARSET=utf8mb4
APP_ENV=development
APP_NAME=Aurevo
APP_BASE_URL=http://127.0.0.1:8000
# Base domain agency subdomains are minted under (e.g. yourplatform.com gives
# agadir-cars.yourplatform.com); leave blank in local dev, no page reads it yet.
PLATFORM_BASE_DOMAIN=
APP_TIMEZONE=Africa/Casablanca
APP_CURRENCY=MAD
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_REGENERATE_INTERVAL=900
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
PENDING_RESERVATION_MINUTES=30
MANAGER_DISCOUNT_THRESHOLD=10
MINIMUM_DRIVER_AGE=21
MINIMUM_LICENCE_MONTHS=12
UPLOAD_MAX_BYTES=5242880
TRUST_PROXY_HEADERS=0
# Required only when running bin/seed_demo.php; choose a strong local-only value.
DEMO_PASSWORD=replace-with-a-strong-demo-password
